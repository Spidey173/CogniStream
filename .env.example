# CogniStream AI — Example Environment Configuration

ENVIRONMENT=production
APP_NAME=CogniStream AI
DEBUG=false
LOG_LEVEL=INFO

# Security & Authentication
API_KEY=dev-secret-api-key
ALLOWED_ORIGINS=*
MAX_FRAME_SIZE_BYTES=5242880

# Database (PostgreSQL / Neon)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require

# Database Batching
BATCH_SIZE=50
BATCH_FLUSH_INTERVAL=2.0

# Redis Pub/Sub (Leave blank for In-Memory message bus)
REDIS_URL=

# Vision & Face Detection
DETECTOR_TYPE=mediapipe
DETECTION_CONFIDENCE=0.5
MAX_VIEWERS=50
